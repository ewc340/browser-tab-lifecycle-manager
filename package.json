{
  "name": "browser-tab-lifecycle-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that sleeps, protects, and automatically cleans up inactive tabs, with a recoverable closure history.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewc340/browser-tab-lifecycle-manager.git"
  },
  "bugs": {
    "url": "https://github.com/ewc340/browser-tab-lifecycle-manager/issues"
  },
  "scripts": {
    "build": "rimraf dist && npm run typecheck && vite build && vite build -c vite.config.sw.ts && npm run build:manifest",
    "build:manifest": "tsx scripts/build-manifest.mjs",
    "dev": "run-p dev:panel dev:sw",
    "dev:panel": "vite build --watch",
    "dev:sw": "vite build --watch -c vite.config.sw.ts",
    "icons": "node scripts/make-icons.mjs",
    "verify": "node scripts/audit-bundle.mjs",
    "package": "npm run build && npm run verify && node scripts/zip.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.2.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "npm-run-all2": "8.0.4",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
